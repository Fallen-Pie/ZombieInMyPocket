import unittest
from encounter import Encounter
import combat from Combat

class Player:
    def __init__(self):
        self.health = 100
        self.damage_taken = 0

    def heal(self, amount):
        self.health += amount

    def take_damage(self, amount):
        self.health -= amount
        self.damage_taken += amount

    def get_health(self):
        return self.health

